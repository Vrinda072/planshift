# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored; this file is the template.

# Postgres container credentials -- used to initialize the postgres image
# on first startup (POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD are read
# directly by the official postgres:16 image's entrypoint script).
POSTGRES_DB=planshift
POSTGRES_USER=planshift
POSTGRES_PASSWORD=changeme

# Backend JDBC connection settings, read by application.yml. DB_HOST/DB_PORT
# point at the postgres service name/port inside the docker-compose network
# (leave these as-is unless you change the service name in docker-compose.yml).
# DB_NAME/DB_USER/DB_PASSWORD must match the POSTGRES_* values above --
# they're the same credentials, just read by a different process.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=planshift
DB_USER=planshift
DB_PASSWORD=changeme
