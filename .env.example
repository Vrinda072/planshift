# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored; this file is the template.

# Postgres container credentials -- used to initialize the postgres image
# on first startup (POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD are read
# directly by the official postgres:16 image's entrypoint script).
POSTGRES_DB=planshift
POSTGRES_USER=planshift
POSTGRES_PASSWORD=changeme

# Which port on your machine maps to Postgres inside the container. Change
# this if 5432 is already taken by another Postgres install. This only
# affects the host-side mapping in docker-compose.yml -- it has nothing to
# do with DB_PORT below, which is the container-internal port the backend
# connects to over the docker network and should stay 5432.
POSTGRES_HOST_PORT=5432

# Backend JDBC connection settings, read by application.yml. DB_HOST/DB_PORT
# point at the postgres service name/port inside the docker-compose network
# (leave these as-is unless you change the service name in docker-compose.yml).
# DB_NAME/DB_USER/DB_PASSWORD must match the POSTGRES_* values above --
# they're the same credentials, just read by a different process.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=planshift
DB_USER=planshift
DB_PASSWORD=changeme

# Host ports for the API and the frontend. Change these if 8080/5173 are
# already taken. Note: BACKEND_HOST_PORT is also baked into the frontend's
# build (it calls http://localhost:${BACKEND_HOST_PORT}), so if you change
# it you need `docker compose up -d --build` (not just `up -d`) for the
# frontend to actually pick up the new backend URL.
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
